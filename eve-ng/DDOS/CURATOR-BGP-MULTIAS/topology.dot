digraph MultiAS {
  graph [rankdir=TB, overlap=false, splines=polyline, nodesep=0.58, ranksep=1.04, bgcolor="white", fontname="DejaVu Sans", label="EVE-NG  |  Multi-AS DDoS Scrubbing / BGP + GRE", labelloc="t", fontsize=22, fontcolor="#192a40", pad=0.4];
