<?xml version="1.0" encoding="utf-8"?>
<lab name="VXLAN-FABRIC-5N-6H" id="5adfe344-0bff-51b3-8af7-7a6881453987" version="2" author="LumaCore Labs" scripttimeout="600" lock="0">
  <description>Five Cisco Nexus 9000v nodes, six VPCS hosts. Reference original thleontev/netlabs GNS3 VXLAN labs; workbook and stage configurations in companion ZIP.</description>
  <body>NXOSv9k image (default nxosv9k-9300v-9.3.9); verify management/ethernet numbering before configuring! EVE CE has no guarantee that startup configs are auto-applied. See README.</body>
  <topology>
    <nodes>
      <node id="11" name="SPINE-01" type="qemu" template="nxosv9k" image="nxosv9k-9300v-9.3.9" console="telnet" cpu="2" ram="8192" ethernet="8" uuid="974f9509-541c-5f14-9d19-a019ba58d0fc" delay="0" icon="Switch.png" left="250" top="50" config="1">
        <interface id="1" name="Eth1/1" type="ethernet" network_id="1"/>
        <interface id="2" name="Eth1/2" type="ethernet" network_id="2"/>
        <interface id="3" name="Eth1/3" type="ethernet" network_id="3"/>
